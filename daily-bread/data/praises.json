م ثابت لايتكدر"],["لا تخشى ياقيصر من أعدائك","إلهى قادر يعطيك مناك","بهلاكهم على يد فتاك"],["ميخائيل أعطاه سيفاً من نار","قائلاً إذا أهلكت البربر","لا تنسى إلهك يا مختار"],["دخل الحرب بقوة وإيمان","وفى يديه يلمع سيفان","خارت الأعداء أسفل الحصان"],["بسرعة انحلوا وزالوا","وجنوده رومية هتفوا وقالوا","أميرنا قد نصره إلهه"],["أعطى الملك رتب ونياشين","وكرامات للرؤساء القادمين","أكثرهم لبطله أبى سيفين"],["دعاهم الكافر للسجود","والتبخير لابولون المعبود","تخلف عنهم وصار فى صمود"],["أنا لا أسجد لحجر وذهب","آلهتك لم تنفع فى الحرب","نزع المنطقة مع الرتب"],["إلهى ومعبودى يسوع","له القربان وبخوره مرفوع","انا أسجد أمامه بخشوع"],["على الصليب هو فدانى","ومن الجحيم قد نجانى","لا أنكره واترك إيمانى"],["دهش داكيوس وطلب إليه","بوعود براقة أثنى عليه","وعدك فانى لا أنظر إليه"],["لا تخالف وقدم الطاعة","لئلا تهان وسط الجماعة","شهيدنا رفض قوله بشجاعة"],["أمر بجلده أمام العسكر","بالهنبازين عظمه تسكر","كشطوا جلده فلم ينكر"],["مدوه على أسياخ حديدية","والنار على جنبيه تقيد","ذاق عذابات مرة هذا الشهيد"],["وضع فى الحبس بأمر الممقوت","فشفاه ملاك وذاق الملكوت","من يؤمن بيسوع لا يموت"],["ربه أقامه ،صرخ جنوده","له نسجد وله عبيده","لا نهاب الموت بل معه نريده"],["فى قيصرية أخذ الأكاليل","بعد أن عزاه عمانوئيل","قبل آلام السيف بتهليل"],["شهادته فى خمسة وعشرين هاتور","ترك الدنيا وسكن فى النور","من يشفع به لايخور"],["ينادى له كل المؤمنين","بدالة يصيحون قائلين","إنجنا يا إله أبو سيفين"],["الله يحفظنا بصلاتك","ويهدينا لنسلك فى صفاتك","ويزيد أفرحنا ببركاتك"],["فى تسعة بؤونة له تذكار عيد","دخول عضوه لمصر بتماجيد","ذخيرة ثمينة تمنح تجديد"],["كم شفى مرضى وفتح عميان","وأنقذ أولاده من الشيطان","قاضى ماهرينصف ببيان"],["وله أيضاً ذكرى تطيب","فى خمسة وعشرين من أبيب","تدشين كنيسة الحبيب"],["أنطونيوس كبير القديسين","كان يصلى فى بلده لسنين","فى كنيسة الشهيد أبى سيفين"],["هو شفيع قوى للعذارى","كالقديسة دميانة البارة","وجميع من يسلك بطهارة"],["نجنا من شر بذيافولوس","كما خلصت الأب باسيليوس","وقتلت الجاحد يوليانوس"],["ثبتنا يارب على الإيمان","شدد سواعد الكسلان","نغلب فقد فاز ببيان"],["يارب أنصرنا بصليبك","وأعمل معنا كأعاجيبك","بشفاعة الشهيد حبيبك"],["ساعدنا يا إلهنا القدوس","فى مدح صفيك بى أثلوفوروس","ونقول جميعاً أكسيوس"]]}]},"george":{"name":"الشهيد العظيم مار جرجس","praises":[{"id":"pr1","type":"tamgeed","title":"السلام لك يا جاورجيوس ذو الاسم العظيم","source":"https://tasbeha.org/hymn_library/view/153","main":true,"verses":[["السلام لك يا مارجرجس،","ذو الإسم العجيب،","أختارك الرب القدوس،","ذاع ذكرك في الأقاليم."],["تقدمت أيها المختار،","إلى دقلديانوس،","واخزيت كل الكفار،","بعلامة بيستاڤروس."],["رأك دقلديانوس،","وعلي وجهك النعمة،","جميلاً في شخصك تضئ،","مثل النجمة."],["فقال \"يا مختار،","أنت من أي مكان،","أنا لي ثلاث أعوام،","ما رأيت مثلك إنسان."],["فما حاجتك عندي،","حتي أتيت الآن،","تعال اخبرني،","أنت من أي مكان."],["بحق يسوع ربك،","تخبرني يا إنسان،","عن أبيك وجدك،","كان وزير أو سلطان.\""],["فقال له جاورجيوس،","\"أنا إبن اسطاسيوس،","وأنا عبد لربي،","إيسوس بخرستوس."],["كبادوكيا بلادنا،","نسبتنا في فلسطين،","فيها مربانا،","منها مقيمين.\""],["فقال له دقلديانوس،","\"تعال اعبد الأوثان،","وبخَّر يا محروس،","وأنا أكتب لك فرمان.\""],["فقال له جاورجيوس،","\"أنا نسل الكِرام،","كيف تأمرني يا مَنْجُوس،","أن أعبد الأوثان.\""],["فأمر دقلديانوس،","عذاب القديس،","والإضداد قد عرُّوه،","وضربوه بالدبابيس."],["سبع سنوات عدة،","يقاسي في الأتعاب،","وأحتمل كل شدة،","في محبة رب الأرباب."],["ثلاث ميتات قد مات،","علي إسمه القدوس،","وحباً في رب القوات،","المحيي كل النفوس."],["وفي رابع موتة،","مضى بالتهليل،","وأخذ الشهادة،","ونال سبعة أكاليل."],["ظفر بالنعمة،","من عند الرب القدوس،","ونال إكليل الشهادة،","باشويس إبؤرو جاورجيوس."],["السلام لك يا بطل،","يا قائد كل الفرسان،","يا مِنْ أجلك خزي،","عبيد الأوثان."],["السلام لك يا قديس،","يا إبن أنسطاسيس،","يا جسداً نقياً،","يا عبد بيخرستوس."],["تفسير إسمك في افواه،","كل المؤمنين،","الكل يقولون \"يا إله،","مارجرجس أعنا اجمعين.\""]]}]}}}
