{"schema":1,"people":{"mary":{"name":"السيدة العذراء مريم","praises":[{"id":"pr1","type":"tamgeed","title":"السلام لك يا مريم يا أم الله القدوس","source":"https://st-takla.org/Lyrics-Spiritual-Songs/08-Coptic-Taraneem-Kalemat_Meem-Noun/Madi7_Al-Kedisa-Al-3athra2-Mariam-1-Ya-Om-Allah-Al-Koddoos.html","main":true,"verses":[["السلام لكِ يا مريم","يا أم الله القدوس","السلام لكِ يا مريم","يا بكر بتول وعروس"],["السلام لكِ يا مريم","يا تابوت عهد النعمة","السلام لكِ يا مريم","يا ثمرة لذيذة طعمة"],["السلام لكِ يا مريم","يا جنة وفردوس","السلام لكِ يا مريم","حملتِ الغير محسوس"],["السلام لكِ يا مريم","يا خليلة سليمان","السلام لكِ يا مريم","يا دواء يبرئ التعبان"],["السلام لكِ يا مريم","يا ذات البتولية","السلام لكِ يا مريم","يا رجاء المسيحية"],["السلام لكِ يا مريم","يا زرع طاهر مبرور","السلام لكِ يا مريم","يا سالمة من الشرور"],["السلام لكِ يا مريم","يا شفيعة في المؤمنين","السلام لكِ يا مريم","يا صلاحًا للخاطئين"],["السلام لكِ يا مريم","يا ضياء في البرية","السلام لكِ يا مريم","يا طاهرة ونقية"],["السلام لكِ يا مريم","يا ظاهرة بأجلى بيان","السلام لكِ يا مريم","يا عروسة للديان"],["السلام لكِ يا مريم","يا غالية وثمينة","السلام لكِ يا مريم","يا فاضلة وأمينة"],["السلام لكِ يا مريم","يا قوية في الحروب","السلام لكِ يا مريم","يا كنز الله المرهوب"],["السلام لكِ يا مريم","يا لوح العهد الجديد","السلام لكِ يا مريم","يا معونة لمن يريد"],["السلام لكِ يا مريم","يا نسل طاهر مغبوط","السلام لكِ يا مريم","يا هيكل نقي مضبوط"],["السلام لكِ يا مريم","يا والدة الإله","السلام لكِ يا مريم","يا لائقة له في علاه"],["السلام لكِ يا مريم","يا ياقوت غالي الأثمان","السلام لكِ يا مريم","يا زهرة في البستان"],["تفسير اسمك في أفواه","كل المؤمنين","الكل يقولون","يا إله العذراء مريم"],["أعنا أجمعين"]]},{"id":"pr2","type":"madih","title":"الزمان يقصر بي ومدحي طويل","source":"https://st-takla.org/Lyrics-Spiritual-Songs/Words-of-Coptic-Alhan-Tasbeha-Kodas/Arabic-Coptic-08-El-Dorah-El-Orthodoxiah/Orthodox-Praises__138-Madeeh-Taweel.html","days":["نياحتها","مجيء العائلة المقدسة لمصر"],"context":"نياحتها","verses":[["الزمان يقصر بي ومدحي طويل","ولساني الفصيح عاجز محبوس","والمجال فسيح وليس لي دليل","إلا أوصاف تي بارثينوس"],["برج القدرة الذي أنشأه","ربه وشرف به الأرض","والإله الكائن في سماه","حل فيه بجلال الفيض"],["تمت المشورة الثالوثية","وانشأت البرج كله نور","وحين قضت الإرادة العلوية","نقله إليه الإله الغيور"],["ثم أن الحمامة حين عملت","أنه قد أن وقت الفراق","نامت للنياح واستعدت","فوق سريرها كشمس الإشراق"],["جبل صهيون العالي مال","والأرض أرتفعت إلى السموات","والروح القدس ليوحنا قال","قم يا ناطق بالإلهيات"],["حبيب الرب يا ثيؤلوغوس","أم إلهك قاربت النياح","حين أسرع وراته تي بارثينوس","صاحت كحمامة بصوت الأفراح"],["خذ المجمرة وقدم البخور","يا يوحنا قم صلي عني","انا والدة الحي غير المنظور","منتظرة لقاء إلهي وابني"],["دل الملائكة اين قبري","قال لها حيث يأمر المرهوب","ناحت الحمامة بدموع تجري","على الخدين لؤلؤا مثقوب"],["داود قم خذ المزمار والقيثار","لنعزي العروس في بكاها","قل صهيون هي ام الجبار","وهو العلي الذي أنشاها"],["ذى من العروس التي خطرت","مرفوعة ومحمولة وهادية","ذى حبة خردل وبذرت","صارت شجرة وسما عليا"],["ذى من التي سميت باب","قم أخبرنا يا حزقيال","مختومًا وفيه رب الأرباب","ولد وختم الباب مازال"],["رؤيا ظهرت لك يا دانيال","بخصوص جحر من جبل مقطوع","قد رآيته من بدء الأجيال","الحجر هو الابن الرب يسوع"],["زمر يا داود وقل للملكة","انصتي واسمعي واصغي بسمعك","ربك في بطنك قد اتكأ","واليوم وقت نياحك قد رفعك"],["سليمان قم لتعزي اختك","قل لها وهي نائمة بنشيد","حرك قيثار نبوتك","قل يا سيدتي نياحك سعيد"],["شتانا انقضي وحل الصيف","والأشجار قاربت الأثمار","يا شجرة عالية ومحل منيف","وزهرك فائق الأعطار"],["صهيون زيني مداخلك وابوابك","واليوم يجئ عندك القدوس","ويري أفضالك وثوابك","ني رومي نيم ني انجيلوس"],["ضمينتك يا آدم قد حضرت","ابنتك ردتك إلى الفردوس","قم عزها لما احتضرت","فهي تابوت لم يقربه سوس"],["سريرك اليوم زاهر","وأثمر بفعل رب القدرة","فيه مسك وطيب ومر وعنبر","وروائح ثيابك عطرة"],["طيبي نفسا يا حوا يا مديونة","بنتك العروس وفت الدين","قومي هنئ الجوهرة المكنونة","قد رفعت عنك كل شين"],["ظهر قربانك يا هابيل","يأبن العروس الميت برضاه","قم يا شيث وغني بالترتيل","وهنئ البتول ام الإله"],["عرشض السموات رأى أخنوخ","ومركبة من نار رفعت إيلياس","البتول أم الشباب والشيوخ","قوموا هنئوها فهي الأساس"],["غشاء تابوتك يا نوح يبلي","كان ساتر سفينتك من المياه","مريم غشاء وكرسي وعجلة","ومنبر حامل الإله"],["فطالما يا إبراهيم اشتهيت","تنظر يوما من أيام ابن الله","ها أمه نائمة للنياح كما رأيت","قم هنئها بقول ما أبهاه"],["قوموا يا أولاد إبراهيم","اسحق ويعقوب وإسرائيل","تعالي يا يوسف الجميل الفهيم","هنئ العذراء بصوت التهليل"],["كملت رموزك يا موسي","والعوسج لم تحرقه نار","قم هنئ البتول العروسة","وتكلم عنها بالأسرار"],["لولاها من كان يقدر","ان يعاين لاهوت يسوع","إلهنا الذي على الأرض ظهر","وروانا بدمه كالينبوع"],["مد خطاك يا صموئيل","وانهض بالعجلة يا حبقوق","بالعذراء تفسر التأويل","انها أم الابن غير المخلوق"],["نادي يا بطرس وأكرز يا توماس","يا لسان العطر بولس السليح","تعالوا هنئوا أم قدس الأقداس","ورئيس الأحبار يسوع المسيح"],["هيأ انظروا يا قديسين هيا","ابنها نازلا على سحاب ونار","كما تنبأ عنه الأنبياء","وكرز به الرسل الأطهار"],["ولت الأسقام عن البتول","لما نظرت ابنها الخالق","فقامت سليمة وهي تقول","أنت من الموت لي عاتق"],["لابد من أن تذوقي الموت","مثلى أنا بيدي الموت والحياة","تواضعت وذقت الآم الموت","لاجل خلاص جنسك من شقاه"],["ما أبهي اليمامة وهي تصيح","لتكون ارادتك يا معبود","المجد لروح قدسك والتسبيح","لك يا الله وكل سجود"],["يا روح الحمامة صعدت للسماء","صيحوا بالنواح يا بنات صهيون","وأزرفن دمعا ودما","على فراق ام إله الكون"],["يا مشتملة بالنور كالثوب","ساعديني على توبة قبل الموت","يا والدة الإله المرهوب","لا تنسينا اكراما لرب الصباؤوت"],["يتوسل نحوك راعينا","ورتب بيعتنا أجمعين","صوني شعب إبنك يا أمينة","رجال ونساء وبنات وبنين"]]},{"id":"pr3","type":"madih","title":"العرش اللحمي لرب القوات","source":"https://st-takla.org/Lyrics-Spiritual-Songs/Words-of-Coptic-Alhan-Tasbeha-Kodas/Arabic-Coptic-08-El-Dorah-El-Orthodoxiah/Orthodox-Praises__139-Al-3arsh-Al-Lahmy.html","days":["صعود جسدها"],"context":"صعود جسدها","verses":[["العرش اللحمي لرب القوات","رفع إلى أعلي السموات","حيث الطوبي والغبطات","والتمجيد فيكل آن"],["بدأ داود يرنم بالألحان","في مديح مريم منذ زمان","قامت الملكة عن يمين السلطان","رب الأرباب منشئ الأكوان"],["توما رسول الابن الكلمة","وهو في الهند قائم بالخدمة","نظر ملائكة نورانية جمة","حاملين جسد أم الديان"],["ثارت أشجانه فناداهم بالصوت","تأنوا يا خدام رب الصباؤوت","حتى انظر مسكن اللاهوت","الذي تجسد منه ابن الرحمن"],["جرى نحوهم في الحال","ونظر جسد ام المتعال","عاين مجد ذى الجلال","الذي له العظمة والسلطان"],["حبقوق اسرى به مولاه","من اورشليم إلى علو سماه","لكي يري وتقرعيناه","بجثمان مريم ام الديان"],["خطب واختار الرب القدوس","النقية مريم البكر العروس","فصارت السماء اللحمي المحسوس","حاملة اللاهوت ذا السلطان"],["دلت النبوات عن مريم","انها العرش بل أعظم","تري الكرسي أم هي أعظم","الكرسي نور حامل النيران"],["ذى مريم البكر البتولية","قد حملت النار المحيية","مريم سحابة روحية","أمطرت لنا الحياة والغفران"],["رآها توما في بلاد الهنود","يحملها من السماء جنود","فأسرع إلى تلاميذ المعبود","وأخبرهم بما رآه بالعيان"],["زف البشري إلى الحواريين","واكد لهم المنظر بيقين","فاستبقوا النبأ متعجبين","إذ كان بعيدًا عن الأوطان"],["سألوه زدنا بيانًا","هل رأيت جسدها عيانًا","أم تريد أعلاءها شأنا","أم بهذا أخبرك إنسان"],["شق ذلك على توما وقال","هيا بنا إلى قبرها في الحال","لنري أن كان جسدها لا يزال","به أم خلا منه المكان"],["صدقوا وآمنوا يا أخوان","إني رأيته مكللا بالتيجان","مرفوعًا إلى السماء بالألحان","على أيدي ملائكة الرحمن"],["ضاق بهم وسيع الأمل","وظنوا قوله غير محتمل","ولكي يحققوا الظن بالعمل","كشفوا القبر بامعان"],["طفقوا ينعمون الفكر والنظر","ويقبلون ما خفي وما ظهر","وقد داخلهم الحزن والكدر","لئلا يكون سرقة إنسان"],["ظهر عليهم الجزع والضجر","وتبلبلت حواسهم والفكر","وقالوا من ذا الذي جسر","اتي واختطف الجسمان"],["على الأكف رايت سيدتي","قال توما وأنا في يقظتي","والملائكة اقتربوا إلى ناحيتي","وشاهدت الجسم بالعيان"],["غريب عنكم ما رأيت","ولكني عاينت وحظيت","وجعلني الله من أبناء البيت","ومثلكم منحت الرضوان"],["فسح القدير لهم الآمال","ووعدهم برؤيتها في جلال","وقد انجز وعده في الحال","ورأوا جسدها حيا كما كان"],["قامت الملكة عن يمين القهار","موشاة بالذهب المختار","على منكبيها قد صار","تبهر لمنظره العينان"],["كل الألسنة البشرية","تطوب هذه العفيفة النقية","وتعلن مناقبها السنية","في كل آن وزمان"],["لها يشير داود البار","جميع مجد ابنة الجبار","مشتملة بحلل الأنوار","مزينة بأبهي الألوان"],["مدوا للوديعة بساط السحاب","ارفعوها إلى عرش وحيد الأب","ادخلوها داخل الحجاب","لتسعد في حضرة السلطان"],["ندى حرمون على الصفوف","قد أمطر برشاش الزوف","ومن تخضع له الألوف","احتجب في احشاها كالصبيان"],["هي تدعي أم الرحمان","هي والدة الإله المنان","أمر لا يختلف فيه اثنان","ولا يدخله الزور والبهتان"],["وثيق فينا هذا الإيمان","إلى لفظ الحياة وغمض الأجفان","لا يحولنا عنه الحدثان","ولا ياتيه الباطل والكفران"],["لإنزال راجين من لدنها","شفاعة منيفة عند أبنها","لأماكن راحة نسكنها","هناك في فردوس الحنان"],["يا من نزل من علو السماء","وتجسد من سيدتنا العذراء","انظر إلينا نحن الضعفاء","وأختم ايامنا بالاحسان"]]},{"id":"pr4","type":"madih","title":"الصوم هو أول وصية","source":"https://st-takla.org/Lyrics-Spiritual-Songs/Words-of-Coptic-Alhan-Tasbeha-Kodas/Arabic-Coptic-08-El-Dorah-El-Orthodoxiah/Orthodox-Praises__140-Awel-Waseya.html","context":"صوم العذراء","refrain":"طوباك طوباك يا مريم","verses":[["الصوم هو أول وصية","أوصى الله بها جد البشرية","خالفها فسقط في الخطية"],["بالصوم والصلاة والعبادة","نالت مريم كل سعادة","مهما استحقت السيادة"],["توما الرسول في بلاد الهنود","فرح وتملي برؤية صعود","جسد مريم أم المعبود"],["ثم أن الرسل الكرام","فرضوا على انفسهم صيام","ليتحققوا رؤية التوأم"],["ثبت لنا من الأخبار","ان العذراء طهر الأطهار","صامت مع الرسل الأبرار"],["جميع المسيحيين يرجون شفاعة","من العذراء عنوان الوداعة","فيقدسون صومها بالطاعة"],["حياتها نموذج للمؤمنين","فليكونوا بها متشبهين","وبرغبة وطهر صائمين"],["خالق الأرض والسموات","نظر لصومها مع الصلوات","فاختارها من بين البنات"],["ذهبت للهيكل نسل الكرام","وهي ابنة ثلاثة أعوام","وكانت تذلل نفسها بالصيام"],["ربنا يسوع قدس الصوم","بصومه عنا أربعين يومًا","والعذراء مع الرسل كانت تصوم"],["زاد عجبي وماذا أقول","في تعبد مريم البكر البتول","شيء لم تدركه العقول"],["سلام لك وألف سلام","يا أم يسوع رب الآنام","يا من تحليت بفضيلة الصيام"],["شفيعة في كل المؤمنين","وقريبة من جميع المسيحيين","الذين هم بالحق مؤمنين"],["صوموا صوما باعتكاف","وتعلموا منها الطهر والعفاف","هي فاقت كل الأشراف"],["ضاع أجر كل من صام","وقلبه مملوء بالآثام","صوموا وتعلموا منها الصيام"],["طوبي لمن صام بالحكمة","طوبي لمن صام وصنع رحمة","تشفع فيه يوم الزحمة"],["ظهر منها عجائب وآيات","بصومها وصلاتها كل الأوقات","خلصت متياس من الضيقات"],["عن يمين الملك العظيم","جلست العذراء م ر ى م","كما قال داود النبي الحكيم"],["غنوا بتسبيح ومديح جديد","صوموا لتنجوا من شر العنيد","بشفاعة العذراء أم الوحيد"],["فرحت بها كل الشعوب","لأنها محت الصك المكتوب","بولادتها للفادي الموهوب"],["قولوا يا اخوة طوباها","وأطلبوا عطفها ورضاها","لتذكرنا امام ابنها ومولاها"],["كل الشعوب المسيحيين","يصوموا صومها بثقة ويقين","وبها دائما متشفعين"],["ليس الصوم للعذراء مريم","الصوم لابنها يسوع العظيم","بها نقتدي ومنها نتعلم"],["مكثت في الهيكل سنين وأيام","مواظبة على الصلاة والصيام","والملائكة تأتيها بطعام"],["نحن ضد الجاحدين","الذين بشفاعة مريم ناكرين","ولذا نصرخ قائلين"],["هي صارت عرشا وسماء","وتفضلت عن الرسل والأنبياء","واعظم من القديسين والشهداء"],["وجميع الشعوب الأرثوذكسية","من صاموا صوما بصفاء ونية","تنجيهم من كل أذية"],["يا رب أحفظ البابا بطركنا","والآباء المطارنة وكهنتها","وسائر رتب بيعتنا"],["واحفظ شعب البيعة بسلام","واعد عليهم هذه الأيام","بشفاعة العذراء ست الآنام"]]},{"id":"pr5","type":"madih","title":"يا م ر ي م","source":"https://st-takla.org/Lyrics-Spiritual-Songs/09-Coptic-Taraneem-Kalemat_Heh-Waw-Yeh/Ya-Mariam-Ya-Sett-El-Abkar.html","context":"تسبحة كيهك وسهرات العذراء","verses":[["يا م ر ي م","يا ست الأبكار","قد نلتِ تعظيم","من نور الأنوار"],["ووهبتِ تعظيم","من عنده قد صار","وحملتِ الخالق","من ذا لا يحتار"],["قد صرتِ أعجوبة","للرؤساء أمثال","دُرة محجوبة","وفي الإنجيل قد قال"],["يُعطونك الطوبى","في كل الأجيال","يا ابنة يواقيم","قد فقتِ الشاروبيم"],["من نال ما نلتِ","يا أم الرحمة","وأنتِ قد صرت","مملوءة نعمة"],["وللاهوت صرتِ","حجابًا للكلمة","واحتار فيكِ","أرباب التفهيم"],["يا تابوت العهد","يا مجمرة هارون","يا روح المجد","يا ابنة صهيون"],["يا نور العيون","بكِ نسعد","ونحظى بالنعيم","يا مملوءة نعمة"],["يا مملوءة نعمة","أنتِ الحصن الحصين","أنتِ كنز الرحمة","يا عون المساكين"],["بابنك زالت النقمة","يا شفيعة القديسين","شفيعتنا في الزحمة","يا أم الرحيم"],["نقدم لكِ التعظيم","يا ست الأبكار","يا ابنة يواقيم","يا كُرسيًا مُختار"],["والمولود منكِ كريم","أزال عنا العار","الإله العظيم","خالق الأدهار"],["يا زين الأبكار","يا قُدس الأحبار","يا طُهر الأطهار","يا نور الأنوار"],["يا كنز النعمة","يا أم الرحمة","أنتِ هي الكرمة","المملوءة أثمار"],["يا ابنة يواقيم","قد نلتِ التعظيم","أنتِ هي أورشليم","ذات المجد والفخار"],["أنتِ هي صهيون","يا جوهر مكنون","فككت المسجون","من يد المكار"],["ابنك خلص آدم","الخاطي النادم","وعتق العالم","من كل الأضرار"],["ربك من صُغرك","لما رأى طُهرك","قد طيب ذِكرك","في كل الأقطار"],["أرسل لك غبريال","بمُحكم الأقوال","وبشرك إذ قال","الله لك اختار"],["روح قدسه ملاكي","وسكن في أحشائك","يا عدرا طوباكِ","في كل الأعصار"],["إن غير المحسوس","الرب القدوس","منك أتى ودُعي إيسوس","ونظرته الأبصار"],["موسى رأى العوسج","والنار فيه تتأجج","وأغصانه تتوهج","ما ضرته النار"],["إن ما رأته العينان","ملتهبًا بالنيران","في العوسج والأغصان","هي مريم زينة الأبكار"],["والنار هي إيسوس","الرب القدوس","معطينا الناموس","مكتوبًا في الأحجار"],["في أشعياء قد قيل","عن هذا التأويل","تلد عمانوئيل","الملك الجبار"],["حزقيال رأى باب","دخل فيه رب الأرباب","وختم الباب مهاب","عالي المقدار"],["عال هو قدرك","لأن يسوع ابنك","لما وُلد منك","تزينت الأمصار"],["أيضًا دانيال","تنبأ حيث قال","رأيت الكرسي العال","عالي المقدار"],["نظرت فوق الأركان","شبه ابن الإنسان","وله السلطان","على كل الأقطار"],["وهو رب القوات","ومن حوله طغمات","ألوف وربوات","من عِظمٍ ووقار"],["يا ابنة يواقيم","فقت الكاروبيم","أيضًا السيرافيم","وكل الآباء الأبرار"],["منك جاء المولود","الرب المعبود","يمدح فيك داود","بالعشرة أوتار"],["الوتر الأول","قول مُبجل","والعدرا تحبل","بالملك الجبار"],["الوتر الثاني","داود في التهاني","يرتل بالألحان","مع ضرب القيثار"],["التالت يا ابنة","أنتِ مؤتمنة","بالنور مشتملة","والرب لكِ اختار"],["الوتر الرابع","أصغ يا سامع","ذا قولًا شائع","في كل الأقطار"],["الخامس خبَّر","حمامة هي تظهر","بالذهب الأصفر","على منكبيها صار"],["والسادس قال فيه","قولًا ما أخفيه","لكني أرويه","وأشهره إجهار"],["والسابع إذ قال","يا جبل الله العال","تجسد منك المُتعال","بلا شك ولا إنكار"],["والتامن رنم","للعدرا مريم","اختارها المُعظم","كللها بالفخار"],["والتاسع قال عنها","يظهر حقًا منها","الإله وهو ابنها","والبكورية في حفظٍ ووقار"],["الوتر العاشر","الله القادر","في صهيون ظاهر","مسكن الأبرار"],["لم يوجد في الدهر","مثلك أيتها البكر","لأنك فككت الأسر","عن آدم والعار"],["يا سيدة الأكوان","يا فخر الإيمان","أنا عبدك حيران","غارق في الأوزار"],["عالٍ هو قدرك","لا تتركي عبدك يا مريم","قصدي من ابنك","عِتقًا من النار"],["لأنك خير من يشفع","وللدعا يسمع","وعنا يدفع","ضربات المكار"],["قم انهض يا مسكين","والبس ثوب اليقين","وقول آمين آمين","فهي تشفع في الحُضار"],["والناظم المسكين","مادحها في كل حين","ماله يوم الدين","سوى سيدة الأبكار"]]},{"id":"pr6","type":"madih","title":"أول ما أبدي أسبح الإله","source":"https://st-takla.org/Lyrics-Spiritual-Songs/Words-of-Coptic-Alhan-Tasbeha-Kodas/Arabic-Coptic-08-El-Dorah-El-Orthodoxiah/Orthodox-Praises__141-Osabeh-Al-Ilah.html","context":"سائر الأعياد عند ملاءمة الطقس","refrain":"اشفعي فينا يا مريم","verses":[["أول ما أبدي أسبح الإله","إله تعالي لا رب سواه","وأمدح مريم البكر الفتاة"],["السلام لك يا بدء السرور","يا من اشتملتي ببهي النور","وحملتي الحي غير المنظور"],["بتول نقية شريفة النسب","من سبط نقي طاهر منتخب","شفاعتك قوية تزيل الغضب"],["تهللتي بفرح جزيل","وحملتي في احشاك سر جليل","يا مرهم شافي لكل عليل"],["جميع الألسن بالتفريح","يطوبونك يا أم المسيح","وانا الخاطئ أصرخ وأصيح"],["جثتك حبا وأنت تعلمي بي","اكثر من ناسي واهلي وأحبابي","وأن ضربوا القرعة انت منابي"],["خاطري طول عمري وحياتي","اكون مادحك كل اوقاتي","لتكوني عوني عند مماتي"],["درة ثمينة وأسمك غالي","يا خدرا طاهرًا يتلالي","انت ربحي ورأس مالي"],["روايحك زكية تفوق الأطياب","وعصيرك احلا من كل شراب","يروي ويزيل جميع الأتعاب"],["زدتي وصفا وشرفا جليل","عن كل نساء آل إسرائيل","ياويل من جحدك يصير ذليل"],["سماء ثانية جسدانية","سميتي يا بكر نقية","لأنك حملت رب البرية"],["شرح فيكي داود البار","ومدح فيكي بصوت المزمار","الرب اشتهي حسنك واختار"],["سببًا صرتي لخلاص أدم","بعد أن كان مأسور نادم","صار وارث ملكوت دايم"],["ضافك إله عظيم معبود","له التمجيد مع السجود","واوفانا الوعد الموعود"],["طوباك في كل الأجيال","يا والدة الملك المتعال","قد تشرف قدرك بالكمال"],["ظفرتي بنعمة من عند الله","كقول غبريال في بشراه","وجدتي دالة دون أصفياه"],["عليك شهدت جميع الآباء","كل منهم قدم بإجابة","وقد دعوك قبة وسحابة"],["غابت فيك كل الأفهام","ولا أمكنهم ان يصفوك بكلام","حملت الإله كشبه غلام"],["فقت مراتب كل الأبرار","وتفضلتي فوق المقدار","طوباك يا طهر الأطهار"],["قد صرت القصر البهي","وحملت الإله غير المحوي","ومنك ظهر السر الخفي"],["كملت أقوال الأنبياء","وكل شهادات نبوية","عن حبلك يا بكر نقية"],["لك يليق كل التعظيم","يا مريم يا أبنة يواقيم","تشبهتي بخيمة إبراهيم"],["ماذا أدعوك يا مريم","منبر طاهر وعرش معظم","وأن قلت الكرسي أنت اعظم"],["نعظمك مدي الأعمار","ونطوبك بفح ووقار","لأننا بك صرنا أحرار"],["هدوءا بطول الدوام","إعطي شعب البيعة بتمام","ليكونوا محفوظين بسلام"],["ويقرأ سلامه إليك يا بكر بتول","بشارة ناظم هذا لقول","جيريه لكي يكون مقبول"],["لاحظيني بشفاعتك يا عذراء","يوم القيامة في الحشرة","حتى أكون فايز بالنصرة"],["يا من قد أسموك الألباب","سماء ثانية لرب الأرباب","جيريني من نار وعذاب"],["والسلام لك يا أم الرحمة","يا والدة الابن الكلمة","طوباك يا مملوءة نعمة"]]}]},"mercurius":{"name":"الشهيد العظيم أبي سيفين (فيلوباتير مرقوريوس)","praises":[{"id":"pr1","type":"tamgeed","title":"تمجيد الشهيد العظيم أبي سيفين","source":"https://www.avarewase.org/glorify_philopateer/","main":true,"refrain":"فيلوباتير مرقوريوس","verses":[["تعالوا نتهلل بالألحان","ونرتل للفادى الديان","فى عيد الشهيد بطل الإيمان"],["أبو سيفين بطل مغوار","له قصة تلحن بالأوتار","شجاع صامت لا يهاب النار"],["والده كان صياد فى الصحراء","صار بشجاعته من الأمراء","عاش بين اكابر ووزراء"],["صار الوالد بعماده نوح","ولأم سفينة مملوءة بالروح","وملاك أعطاه أسماً ممدوح"],["وشفيع العيلة الملاك ميخائيل","قادهم فى خوف عمانوئيل","ثمرتها هذا البطل النبيل"],["فروسية تعلم وهو شاب","ولذا أسند له عمل الآب","وتعاظم فصار أركان حرب"],["أفزع داكيوس حرب البربر","فجمع جنوده والعسكر","رئيسهم ثابت لايتكدر"],["لا تخشى ياقيصر من أعدائك","إلهى قادر يعطيك مناك","بهلاكهم على يد فتاك"],["ميخائيل أعطاه سيفاً من نار","قائلاً إذا أهلكت البربر","لا تنسى إلهك يا مختار"],["دخل الحرب بقوة وإيمان","وفى يديه يلمع سيفان","خارت الأعداء أسفل الحصان"],["بسرعة انحلوا وزالوا","وجنوده رومية هتفوا وقالوا","أميرنا قد نصره إلهه"],["أعطى الملك رتب ونياشين","وكرامات للرؤساء القادمين","أكثرهم لبطله أبى سيفين"],["دعاهم الكافر للسجود","والتبخير لابولون المعبود","تخلف عنهم وصار فى صمود"],["أنا لا أسجد لحجر وذهب","آلهتك لم تنفع فى الحرب","نزع المنطقة مع الرتب"],["إلهى ومعبودى يسوع","له القربان وبخوره مرفوع","انا أسجد أمامه بخشوع"],["على الصليب هو فدانى","ومن الجحيم قد نجانى","لا أنكره واترك إيمانى"],["دهش داكيوس وطلب إليه","بوعود براقة أثنى عليه","وعدك فانى لا أنظر إليه"],["لا تخالف وقدم الطاعة","لئلا تهان وسط الجماعة","شهيدنا رفض قوله بشجاعة"],["أمر بجلده أمام العسكر","بالهنبازين عظمه تسكر","كشطوا جلده فلم ينكر"],["مدوه على أسياخ حديدية","والنار على جنبيه تقيد","ذاق عذابات مرة هذا الشهيد"],["وضع فى الحبس بأمر الممقوت","فشفاه ملاك وذاق الملكوت","من يؤمن بيسوع لا يموت"],["ربه أقامه ،صرخ جنوده","له نسجد وله عبيده","لا نهاب الموت بل معه نريده"],["فى قيصرية أخذ الأكاليل","بعد أن عزاه عمانوئيل","قبل آلام السيف بتهليل"],["شهادته فى خمسة وعشرين هاتور","ترك الدنيا وسكن فى النور","من يشفع به لايخور"],["ينادى له كل المؤمنين","بدالة يصيحون قائلين","إنجنا يا إله أبو سيفين"],["الله يحفظنا بصلاتك","ويهدينا لنسلك فى صفاتك","ويزيد أفرحنا ببركاتك"],["فى تسعة بؤونة له تذكار عيد","دخول عضوه لمصر بتماجيد","ذخيرة ثمينة تمنح تجديد"],["كم شفى مرضى وفتح عميان","وأنقذ أولاده من الشيطان","قاضى ماهرينصف ببيان"],["وله أيضاً ذكرى تطيب","فى خمسة وعشرين من أبيب","تدشين كنيسة الحبيب"],["أنطونيوس كبير القديسين","كان يصلى فى بلده لسنين","فى كنيسة الشهيد أبى سيفين"],["هو شفيع قوى للعذارى","كالقديسة دميانة البارة","وجميع من يسلك بطهارة"],["نجنا من شر بذيافولوس","كما خلصت الأب باسيليوس","وقتلت الجاحد يوليانوس"],["ثبتنا يارب على الإيمان","شدد سواعد الكسلان","نغلب فقد فاز ببيان"],["يارب أنصرنا بصليبك","وأعمل معنا كأعاجيبك","بشفاعة الشهيد حبيبك"],["ساعدنا يا إلهنا القدوس","فى مدح صفيك بى أثلوفوروس","ونقول جميعاً أكسيوس"]]}]},"george":{"name":"الشهيد العظيم مار جرجس","praises":[{"id":"pr1","type":"tamgeed","title":"السلام لك يا جاورجيوس ذو الاسم العظيم","source":"https://tasbeha.org/hymn_library/view/153","main":true,"verses":[["السلام لك يا مارجرجس،","ذو الإسم العجيب،","أختارك الرب القدوس،","ذاع ذكرك في الأقاليم."],["تقدمت أيها المختار،","إلى دقلديانوس،","واخزيت كل الكفار،","بعلامة بيستاڤروس."],["رأك دقلديانوس،","وعلي وجهك النعمة،","جميلاً في شخصك تضئ،","مثل النجمة."],["فقال \"يا مختار،","أنت من أي مكان،","أنا لي ثلاث أعوام،","ما رأيت مثلك إنسان."],["فما حاجتك عندي،","حتي أتيت الآن،","تعال اخبرني،","أنت من أي مكان."],["بحق يسوع ربك،","تخبرني يا إنسان،","عن أبيك وجدك،","كان وزير أو سلطان.\""],["فقال له جاورجيوس،","\"أنا إبن اسطاسيوس،","وأنا عبد لربي،","إيسوس بخرستوس."],["كبادوكيا بلادنا،","نسبتنا في فلسطين،","فيها مربانا،","منها مقيمين.\""],["فقال له دقلديانوس،","\"تعال اعبد الأوثان،","وبخَّر يا محروس،","وأنا أكتب لك فرمان.\""],["فقال له جاورجيوس،","\"أنا نسل الكِرام،","كيف تأمرني يا مَنْجُوس،","أن أعبد الأوثان.\""],["فأمر دقلديانوس،","عذاب القديس،","والإضداد قد عرُّوه،","وضربوه بالدبابيس."],["سبع سنوات عدة،","يقاسي في الأتعاب،","وأحتمل كل شدة،","في محبة رب الأرباب."],["ثلاث ميتات قد مات،","علي إسمه القدوس،","وحباً في رب القوات،","المحيي كل النفوس."],["وفي رابع موتة،","مضى بالتهليل،","وأخذ الشهادة،","ونال سبعة أكاليل."],["ظفر بالنعمة،","من عند الرب القدوس،","ونال إكليل الشهادة،","باشويس إبؤرو جاورجيوس."],["السلام لك يا بطل،","يا قائد كل الفرسان،","يا مِنْ أجلك خزي،","عبيد الأوثان."],["السلام لك يا قديس،","يا إبن أنسطاسيس،","يا جسداً نقياً،","يا عبد بيخرستوس."],["تفسير إسمك في افواه،","كل المؤمنين،","الكل يقولون \"يا إله،","مارجرجس أعنا اجمعين.\""]]}]}}}
