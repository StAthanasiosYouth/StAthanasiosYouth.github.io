{
  "name": "athanasios-links-tools",
  "private": true,
  "type": "module",
  "description": "Dev-only tooling: asset optimization, seed content, QR/OG rendering, tests. Not deployed.",
  "scripts": {
    "assets": "node build-assets.mjs",
    "seed": "node build-seed.mjs",
    "icons": "node gen-brand-icons.mjs",
    "sync": "node sync-admin.mjs && node build-admin.mjs",
    "test": "node --test ../tests/*.test.mjs",
    "serve": "node serve.mjs",
    "e2e": "node --test --test-concurrency=1 ../tests/browser.e2e.mjs ../tests/hub.e2e.mjs ../tests/admin.e2e.mjs ../tests/layout.e2e.mjs ../tests/xp.e2e.mjs ../tests/feel.e2e.mjs ../tests/polish-a.e2e.mjs ../tests/polish-b.e2e.mjs ../tests/refine-a.e2e.mjs ../tests/prog-a.e2e.mjs ../tests/refine-b.e2e.mjs ../tests/admin-rel.e2e.mjs ../tests/admin-layout.e2e.mjs ../tests/prog-b.e2e.mjs ../tests/final-r.e2e.mjs ../tests/final-m.e2e.mjs ../tests/final-s.e2e.mjs ../tests/final-v.e2e.mjs ../tests/fix-admin.e2e.mjs",
    "set-url": "node set-url.mjs",
    "demo": "node demo.mjs",
    "example": "node build-example.mjs",
    "build-admin": "node build-admin.mjs",
    "build-vendor": "node build-admin-vendor.mjs",
    "build-push-vendor": "node build-push-vendor.mjs",
    "pwa-icons": "node build-pwa-icons.mjs"
  },
  "devDependencies": {
    "axe-core": "^4.13.0",
    "esbuild": "0.28.2",
    "firebase": "12.19.0",
    "jsqr": "^1.4.0",
    "mediabunny": "1.61.3",
    "puppeteer-core": "^23.11.1",
    "qrcode-generator": "^2.0.4",
    "sharp": "^0.35.5",
    "simple-icons": "^16.34.0"
  }
}
